# ==============================================================================
# AqarPulse Platform — Environment Configuration (.env.example)
# Safe Template — NEVER commit actual secrets, API keys, or credentials to Git
# ==============================================================================

# Application URL & Environment (Web & Capacitor Mobile)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=https://aqarpulse.eg
NEXT_PUBLIC_SITE_URL=https://aqarpulse.eg
NODE_ENV=development

# Authentication & Session Security
# CRITICAL: In production, SESSION_SECRET must be set and contain at least 32 characters
SESSION_SECRET=your_production_session_signing_secret_min_32_characters_random_hex_or_base64
JWT_SECRET=your_production_jwt_secret_min_32_characters
SESSION_COOKIE_MAX_AGE_DAYS=7

# Supabase Cloud Database & Storage (Production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here
# Server-side ONLY: Never expose SUPABASE_SERVICE_ROLE_KEY to client or public bundles
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL Direct Connection (Optional)
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/aqarpulse?schema=public&sslmode=prefer

# Geospatial Map Provider Configuration (CARTO Basemaps & OpenStreetMap)
CARTO_BASEMAPS_API_KEY=your_carto_basemaps_api_key_here
NEXT_PUBLIC_CARTO_BASEMAPS_API_KEY=your_carto_basemaps_api_key_here
MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors &copy; <a href=\"https://carto.com/attributions\">CARTO</a>"
DEFAULT_CITY_CENTER_LAT=30.0444
DEFAULT_CITY_CENTER_LNG=31.2357
DEFAULT_MAP_ZOOM=12

# Location Privacy Default Radius (in meters)
LOCATION_PRIVACY_RADIUS_METERS=500

# Object Storage for Property Media (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=supabase_storage
S3_BUCKET_NAME=property-images
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Email / SMTP Verification (Gmail App Password or SMTP Gateway)
EMAIL_USER=your_smtp_user@example.com
EMAIL_PASS=your_smtp_app_password
GMAIL_USER=your_gmail_user@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_NAME="نبض العقار | AqarPulse"

# SMS & WhatsApp Notifications (Twilio / Wasapi / Local Provider)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ENDPOINT=https://graph.facebook.com/v20.0
WHATSAPP_API_KEY=
SMS_GATEWAY_URL=
