# ==============================================================================
# AqarPulse Platform — Environment Configuration (.env.example)
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Authentication & Session Security
JWT_SECRET=aqarpulse_super_secret_jwt_key_egypt_2026
SESSION_COOKIE_MAX_AGE_DAYS=7

# Database Connection (PostgreSQL + PostGIS Production)
# For local development with zero external dependencies, the platform uses an embedded
# persistent PostGIS-compatible spatial file engine (.data/aqarpulse_db.json).
# To connect to production PostgreSQL with PostGIS, set:
DATABASE_URL=postgresql://postgres:password@localhost:5432/aqarpulse?schema=public&sslmode=prefer

# Geospatial Map Provider Configuration (CARTO Basemaps & OpenStreetMap)
# For Next.js client-side tile requests in Leaflet, NEXT_PUBLIC_CARTO_BASEMAPS_API_KEY is used.
CARTO_BASEMAPS_API_KEY=your_carto_basemaps_api_key_here
NEXT_PUBLIC_CARTO_BASEMAPS_API_KEY=your_carto_basemaps_api_key_here
MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a> contributors &copy; <a href=\"https://carto.com/attributions\">CARTO</a>"
DEFAULT_CITY_CENTER_LAT=30.0444
DEFAULT_CITY_CENTER_LNG=31.2357
DEFAULT_MAP_ZOOM=12

# Location Privacy Default Radius (in meters)
LOCATION_PRIVACY_RADIUS_METERS=500

# Object Storage for Property Media (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_PROVIDER=local_or_s3
S3_BUCKET_NAME=aqarpulse-property-images
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# SMS & WhatsApp Notifications (Twilio / Wasapi / Local Provider)
WHATSAPP_API_KEY=
SMS_GATEWAY_URL=
